# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the Razorpay webhook to update subscriptions. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in auth emails and payment callbacks.
# In production set it to your live domain, e.g. https://yourdomain.com
# (if it's missing or localhost, the app uses the domain the request came in on).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agora live video (console.agora.io -> Projects). Without these the room
# still works, minus video. Both are read by the server at request time; the
# token route hands the App ID to the browser. The certificate enables token
# auth (leave it empty only for a "testing mode" project).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Razorpay (dashboard.razorpay.com -> Account & Settings -> API Keys).
# Use rzp_test_ keys while testing, rzp_live_ keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Subscriptions -> Plans -> create "Pro", monthly, ₹499. Paste its plan_... id.
RAZORPAY_PLAN_ID=
# Settings -> Webhooks -> URL https://yourdomain.com/api/billing/webhook,
# events subscription.*; paste the secret you chose.
RAZORPAY_WEBHOOK_SECRET=

# Resend (resend.com -> API Keys). Emails: confirmation, 24 h / 1 h reminders, "we're live".
# EMAIL_FROM must use a domain you verified in Resend -> Domains, e.g. "Deploy & Grow Webinar <hello@yourdomain.com>".
# For a quick test without a domain, use "Deploy & Grow Webinar <onboarding@resend.dev>" (only delivers to your own Resend email).
# Emails also need SUPABASE_SERVICE_ROLE_KEY (above).
RESEND_API_KEY=
EMAIL_FROM=
# Optional: where replies go.
EMAIL_REPLY_TO=

# Protects /api/cron/emails, which sends the reminders. Any long random string.
CRON_SECRET=
